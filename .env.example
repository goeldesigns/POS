# ─────────────────────────────────────────────────────────────
# Tabla POS — environment configuration
# Copy to `.env` and adjust. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection. `npm run db:local` starts an embedded
# Postgres on port 5433 matching these defaults (dev only).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tabla_dev?schema=public"

# Separate database used by `npm test`. Tests create uniquely named records
# and delete them afterwards; never point this at real data.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tabla_test?schema=public"

# Public base URL of the app (used in password-reset links, receipts).
APP_URL="http://localhost:3000"

# 32-byte key (base64) for encrypting integration credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="REPLACE_WITH_32_BYTE_BASE64_KEY"

# Shared secret for scheduled jobs (e.g. loyalty point expiry).
CRON_SECRET="REPLACE_WITH_RANDOM_STRING"

# Session lifetime in days (sliding).
SESSION_TTL_DAYS="14"

# Directory for uploaded files (product images, expense receipts).
STORAGE_DIR="./storage"
