# ─────────────────────────────────────────────────────────────
# Tabla POS UI — environment configuration
# Copy to `.env` and adjust. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Base URL of the Spring Boot backend the UI calls on the server.
# The browser reaches the same API at /api/v1 on this app's own origin
# (nginx in production, a Next.js rewrite in development).
BACKEND_URL="http://127.0.0.1:8081"

# Public base URL of the app, used in shareable links.
APP_URL="http://localhost:3000"
