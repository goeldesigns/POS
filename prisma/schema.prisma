// ─────────────────────────────────────────────────────────────────────────────
// Tabla POS — multi-tenant schema
//
// Conventions
//  • `Restaurant` is the tenant. Every restaurant-owned row carries a
//    non-null `restaurantId` FK and is queried through the tenant-scoped client
//    (src/server/tenant-db.ts) which injects the tenant filter automatically.
//  • Money is stored as integers in minor units (paise for INR).
//  • Stock quantities are stored as floats in the ingredient's own unit.
//  • Soft-deletes (`deletedAt`) are used where historical records reference rows.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════ Enums ══════════════════════════════════════

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum SessionScope {
  PLATFORM
  RESTAURANT
}

enum PermissionEffect {
  GRANT
  DENY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum FoodType {
  VEG
  NON_VEG
  EGG
  VEGAN
}

enum OrderSource {
  POS
  WEBSITE
  SWIGGY
  ZOMATO
  ADMIN
  OTHER
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  ONLINE
}

enum OrderStatus {
  DRAFT
  NEW
  PREPARING
  READY
  /// Food handed over, bill still open (table service: guests pay after eating).
  SERVED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  WALLET
  OTHER
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum DiscountType {
  PERCENT
  FLAT
}

enum DiscountSource {
  MANUAL
  COUPON
  LOYALTY
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  BLOCKED
}

enum TableShape {
  SQUARE
  ROUND
  RECTANGLE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  RAW_MATERIALS
  MAINTENANCE
  MARKETING
  TRANSPORT
  OTHER
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  LEAVE
}

enum StockUnit {
  KG
  G
  LTR
  ML
  PCS
  BOX
  PACK
}

enum StockTxnType {
  OPENING
  PURCHASE
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  WASTE
  RETURN
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum LoyaltyTxnType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  BONUS
  REVERSAL
}

enum IntegrationProvider {
  SWIGGY
  ZOMATO
}

enum IntegrationStatus {
  DISCONNECTED
  PENDING
  CONNECTED
  ERROR
}

enum ExternalOrderStatus {
  RECEIVED
  IMPORTED
  REJECTED
  FAILED
}

enum AuditScope {
  PLATFORM
  RESTAURANT
}

enum DemoStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// ═══════════════════════════ Identity & access ══════════════════════════════

/// Global identity. A user can belong to several restaurants through
/// RestaurantUser; platform staff carry a `platformRole`.
model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  phone        String?
  passwordHash String
  platformRole PlatformRole?
  status       UserStatus    @default(ACTIVE)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships         RestaurantUser[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  ordersCreated       Order[]              @relation("OrderCreatedBy")
  demosAssigned       DemoRequest[]        @relation("DemoAssignee")
}

model Session {
  id           String       @id @default(cuid())
  tokenHash    String       @unique
  userId       String
  scope        SessionScope
  restaurantId String?
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  lastSeenAt   DateTime     @default(now())
  createdAt    DateTime     @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([restaurantId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Catalogue of every permission key (e.g. `orders.create`). Synced from
/// src/lib/permissions/catalog.ts by the seed / onboarding service.
model Permission {
  key         String  @id
  module      String
  action      String
  label       String
  description String?
  sortOrder   Int     @default(0)

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model Role {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  /// System roles are created during onboarding and cannot be deleted.
  isSystem     Boolean  @default(false)
  /// Owner roles implicitly hold every permission of every enabled module.
  isOwner      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  members     RestaurantUser[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model RolePermission {
  roleId        String
  permissionKey String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([roleId, permissionKey])
}

/// Membership of a user in a restaurant (tenant).
model RestaurantUser {
  id           String           @id @default(cuid())
  restaurantId String
  userId       String
  roleId       String
  status       MembershipStatus @default(ACTIVE)
  lastActiveAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  restaurant  Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        Role             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissions UserPermission[]
  staff       StaffMember?

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
}

/// Per-user override on top of the role: GRANT adds, DENY removes.
model UserPermission {
  id               String           @id @default(cuid())
  restaurantId     String
  restaurantUserId String
  permissionKey    String
  effect           PermissionEffect

  restaurant     Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantUser RestaurantUser @relation(fields: [restaurantUserId], references: [id], onDelete: Cascade)
  permission     Permission     @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([restaurantUserId, permissionKey])
  @@index([restaurantId])
}

/// Modules switched on/off for a tenant by the platform (Super Admin).
model RestaurantModule {
  restaurantId String
  moduleKey    String
  enabled      Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, moduleKey])
}

/// Hashed API keys for server-to-server access (customer website, apps).
model ApiKey {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  prefix       String
  keyHash      String    @unique
  scopes       String[]
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
}

// ═══════════════════════════ Tenant & billing ═══════════════════════════════

model Restaurant {
  id             String           @id @default(cuid())
  slug           String           @unique
  name           String
  legalName      String?
  ownerName      String
  email          String
  phone          String
  addressLine    String?
  city           String?
  state          String?
  country        String           @default("India")
  postalCode     String?
  gstNumber      String?
  fssaiNumber    String?
  currency       String           @default("INR")
  timezone       String           @default("Asia/Kolkata")
  locale         String           @default("en-IN")
  restaurantType String           @default("Casual Dining")
  logoUrl        String?
  status         RestaurantStatus @default(ACTIVE)
  suspendedAt    DateTime?
  suspendReason  String?
  deletedAt      DateTime?
  lastActiveAt   DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  settings          RestaurantSettings?
  subscription      Subscription?
  loyaltyProgram    LoyaltyProgram?
  modules           RestaurantModule[]
  roles             Role[]
  members           RestaurantUser[]
  userPermissions   UserPermission[]
  sessions          Session[]
  apiKeys           ApiKey[]
  taxRates          TaxRate[]
  categories        Category[]
  products          Product[]
  productVariants   ProductVariant[]
  modifierGroups    ModifierGroup[]
  modifiers         Modifier[]
  comboItems        ComboItem[]
  floors            Floor[]
  tables            DiningTable[]
  reservations      Reservation[]
  customers         Customer[]
  customerAddresses CustomerAddress[]
  customerNotes     CustomerNote[]
  coupons           Coupon[]
  orders            Order[]
  orderItems        OrderItem[]
  orderPayments     OrderPayment[]
  orderDiscounts    OrderDiscount[]
  orderTaxes        OrderTax[]
  orderEvents       OrderEvent[]
  expenses          Expense[]
  staff             StaffMember[]
  attendance        Attendance[]
  shifts            Shift[]
  suppliers         Supplier[]
  ingredients       Ingredient[]
  recipes           Recipe[]
  recipeIngredients RecipeIngredient[]
  purchases         Purchase[]
  purchaseItems     PurchaseItem[]
  stockTransactions StockTransaction[]
  wastes            Waste[]
  loyaltyAccounts   LoyaltyAccount[]
  loyaltyTxns       LoyaltyTransaction[]
  integrations      Integration[]
  integrationCreds  IntegrationCredential[]
  externalOrders    ExternalOrder[]
  auditLogs         AuditLog[]
  demoRequests      DemoRequest[]

  @@index([status])
}

/// One row per tenant; every operational setting the POS reads.
model RestaurantSettings {
  restaurantId String @id

  // Tax & charges
  taxInclusive               Boolean   @default(false)
  serviceChargePercent       Float     @default(0)
  roundOffTotals             Boolean   @default(true)
  // Orders
  defaultOrderType           OrderType @default(DINE_IN)
  orderPrefix                String    @default("ORD")
  nextOrderNumber            Int       @default(1001)
  /// true = no kitchen display: paid counter orders close at once instead of going to the kitchen board.
  autoCompleteOnPayment      Boolean   @default(false)
  requireCustomerForDelivery Boolean   @default(true)
  allowNegativeStock         Boolean   @default(true)
  // Invoice & receipt
  invoicePrefix              String    @default("INV")
  receiptHeader              String?
  receiptFooter              String?   @default("Thank you for dining with us!")
  receiptShowGstin           Boolean   @default(true)
  receiptShowFssai           Boolean   @default(true)
  receiptPaperWidth          Int       @default(80)
  // Payments
  acceptCash                 Boolean   @default(true)
  acceptCard                 Boolean   @default(true)
  acceptUpi                  Boolean   @default(true)
  upiId                      String?
  // Kitchen & printing
  autoPrintKot               Boolean   @default(false)
  autoPrintReceipt           Boolean   @default(false)
  kitchenStations            String[]  @default(["Main Kitchen", "Tandoor", "Bar", "Desserts"])
  receiptPrinterName         String?
  kitchenPrinterName         String?
  // Tables & reservations
  freeTableAfterPayment      Boolean   @default(true)
  reservationSlotMinutes     Int       @default(30)
  reservationDurationMinutes Int       @default(90)
  reservationLeadMinutes     Int       @default(60)
  // Purchases
  nextPurchaseNumber         Int       @default(1)
  // Notifications
  notifyLowStock             Boolean   @default(true)
  notifyNewOnlineOrder       Boolean   @default(true)
  notifyReservations         Boolean   @default(true)
  dailySummaryEmail          String?
  // Security
  sessionTimeoutMinutes      Int       @default(720)
  requireManagerForVoid      Boolean   @default(true)

  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model Plan {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  priceMonthly Int
  priceYearly  Int
  currency     String   @default("INR")
  trialDays    Int      @default(14)
  maxUsers     Int?
  maxTables    Int?
  maxProducts  Int?
  maxLocations Int?
  isActive     Boolean  @default(true)
  isPublic     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  features      SubscriptionFeature[]
  subscriptions Subscription[]
}

/// Feature flags / module entitlements carried by a plan.
model SubscriptionFeature {
  id         String  @id @default(cuid())
  planId     String
  featureKey String
  enabled    Boolean @default(true)
  limit      Int?

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

/// Billing provider fields are intentionally generic so Razorpay or Stripe can
/// be attached later without schema changes.
model Subscription {
  id                     String             @id @default(cuid())
  restaurantId           String             @unique
  planId                 String
  status                 SubscriptionStatus @default(TRIALING)
  billingInterval        BillingInterval    @default(MONTHLY)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  priceOverride          Int?
  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan       Plan       @relation(fields: [planId], references: [id], onDelete: Restrict)
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ═══════════════════════════════ Menu ═══════════════════════════════════════

model TaxRate {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  rate         Float
  isDefault    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([restaurantId, name])
}

model Category {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String?
  color        String?
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model Product {
  id              String    @id @default(cuid())
  restaurantId    String
  categoryId      String
  taxRateId       String?
  name            String
  sku             String
  description     String?
  price           Int
  costPrice       Int?
  imageUrl        String?
  foodType        FoodType  @default(VEG)
  isActive        Boolean   @default(true)
  isAvailable     Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  isBestseller    Boolean   @default(false)
  isSpicy         Boolean   @default(false)
  isCombo         Boolean   @default(false)
  trackStock      Boolean   @default(true)
  preparationTime Int?
  barcode         String?
  kitchenStation  String?
  sortOrder       Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  taxRate        TaxRate?               @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  modifierGroups ProductModifierGroup[]
  comboItems     ComboItem[]            @relation("ComboParent")
  usedInCombos   ComboItem[]            @relation("ComboComponent")
  recipe         Recipe?
  orderItems     OrderItem[]

  @@unique([restaurantId, sku])
  @@index([restaurantId, categoryId])
}

model ProductVariant {
  id           String  @id @default(cuid())
  restaurantId String
  productId    String
  name         String
  price        Int
  isDefault    Boolean @default(false)
  sortOrder    Int     @default(0)

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model ModifierGroup {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  minSelect    Int      @default(0)
  maxSelect    Int      @default(1)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers  Modifier[]
  products   ProductModifierGroup[]

  @@unique([restaurantId, name])
}

model Modifier {
  id           String  @id @default(cuid())
  restaurantId String
  groupId      String
  name         String
  price        Int     @default(0)
  isActive     Boolean @default(true)
  sortOrder    Int     @default(0)

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model ProductModifierGroup {
  productId       String
  modifierGroupId String

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@id([productId, modifierGroupId])
}

/// Components of a combo product (Product.isCombo = true).
model ComboItem {
  id           String @id @default(cuid())
  restaurantId String
  comboId      String
  productId    String
  quantity     Int    @default(1)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  combo      Product    @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
  product    Product    @relation("ComboComponent", fields: [productId], references: [id], onDelete: Restrict)

  @@unique([comboId, productId])
}

// ═══════════════════════════ Floor & tables ═════════════════════════════════

model Floor {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  restaurant Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables     DiningTable[]

  @@unique([restaurantId, name])
}

model DiningTable {
  id            String      @id @default(cuid())
  restaurantId  String
  floorId       String
  name          String
  capacity      Int         @default(4)
  shape         TableShape  @default(SQUARE)
  status        TableStatus @default(AVAILABLE)
  occupiedSince DateTime?
  /// When tables are merged, child tables point at the primary table.
  mergedIntoId  String?
  sortOrder     Int         @default(0)
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  floor        Floor         @relation(fields: [floorId], references: [id], onDelete: Restrict)
  mergedInto   DiningTable?  @relation("TableMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedTables DiningTable[] @relation("TableMerge")
  orders       Order[]
  reservations Reservation[]

  @@unique([restaurantId, name])
  @@index([restaurantId, floorId])
}

model Reservation {
  id              String            @id @default(cuid())
  restaurantId    String
  customerId      String?
  tableId         String?
  customerName    String
  customerPhone   String
  customerEmail   String?
  startsAt        DateTime
  durationMinutes Int               @default(90)
  partySize       Int
  status          ReservationStatus @default(PENDING)
  source          String            @default("Phone")
  notes           String?
  seatedAt        DateTime?
  createdById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table      DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([restaurantId, startsAt])
}

// ═══════════════════════════════ Customers ══════════════════════════════════

model Customer {
  id           String    @id @default(cuid())
  restaurantId String
  name         String
  phone        String
  email        String?
  birthday     DateTime?
  anniversary  DateTime?
  tags         String[]
  totalOrders  Int       @default(0)
  totalSpend   Int       @default(0)
  lastVisitAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  addresses    CustomerAddress[]
  notes        CustomerNote[]
  orders       Order[]
  reservations Reservation[]
  loyalty      LoyaltyAccount?
  loyaltyTxns  LoyaltyTransaction[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, name])
}

model CustomerAddress {
  id           String  @id @default(cuid())
  restaurantId String
  customerId   String
  label        String  @default("Home")
  line1        String
  line2        String?
  landmark     String?
  city         String
  state        String?
  postalCode   String?
  isDefault    Boolean @default(false)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerNote {
  id           String   @id @default(cuid())
  restaurantId String
  customerId   String
  authorName   String
  body         String
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Coupon {
  id           String       @id @default(cuid())
  restaurantId String
  code         String
  description  String?
  type         DiscountType
  value        Float
  minOrder     Int?
  maxDiscount  Int?
  validFrom    DateTime?
  validTo      DateTime?
  usageLimit   Int?
  usedCount    Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, code])
}

// ═══════════════════════════════ Orders ═════════════════════════════════════

/// One order pipeline for every source (POS, website, aggregators, admin).
model Order {
  id                    String        @id @default(cuid())
  restaurantId          String
  number                Int
  orderNumber           String
  source                OrderSource   @default(POS)
  type                  OrderType     @default(DINE_IN)
  status                OrderStatus   @default(NEW)
  paymentStatus         PaymentStatus @default(UNPAID)
  tableId               String?
  customerId            String?
  customerName          String?
  customerPhone         String?
  deliveryAddress       String?
  guests                Int?
  notes                 String?
  subtotal              Int           @default(0)
  discountTotal         Int           @default(0)
  taxTotal              Int           @default(0)
  serviceCharge         Int           @default(0)
  roundOff              Int           @default(0)
  total                 Int           @default(0)
  paidTotal             Int           @default(0)
  refundedTotal         Int           @default(0)
  loyaltyPointsEarned   Int           @default(0)
  loyaltyPointsRedeemed Int           @default(0)
  inventoryDeducted     Boolean       @default(false)
  externalRef           String?
  createdById           String?
  placedAt              DateTime?
  preparingAt           DateTime?
  readyAt               DateTime?
  servedAt              DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  cancelReason          String?
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table         DiningTable?         @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customer      Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy     User?                @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items         OrderItem[]
  payments      OrderPayment[]
  discounts     OrderDiscount[]
  taxes         OrderTax[]
  events        OrderEvent[]
  externalOrder ExternalOrder?
  loyaltyTxns   LoyaltyTransaction[]
  stockTxns     StockTransaction[]

  @@unique([restaurantId, number])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status])
  @@index([restaurantId, tableId])
  @@index([restaurantId, customerId])
}

model OrderItem {
  id             String   @id @default(cuid())
  restaurantId   String
  orderId        String
  productId      String?
  variantId      String?
  name           String
  variantName    String?
  categoryName   String?
  kitchenStation String?
  unitPrice      Int
  quantity       Int
  /// Snapshot: [{ id, name, price }]
  modifiers      Json     @default("[]")
  modifiersTotal Int      @default(0)
  discount       Int      @default(0)
  taxRate        Float    @default(0)
  taxAmount      Int      @default(0)
  lineTotal      Int
  notes          String?
  createdAt      DateTime @default(now())

  restaurant Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([restaurantId, productId])
}

model OrderPayment {
  id             String        @id @default(cuid())
  restaurantId   String
  orderId        String
  kind           PaymentKind   @default(PAYMENT)
  method         PaymentMethod
  amount         Int
  receivedAmount Int?
  changeAmount   Int?
  reference      String?
  notes          String?
  processedById  String?
  createdAt      DateTime      @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([restaurantId, createdAt])
}

model OrderDiscount {
  id           String         @id @default(cuid())
  restaurantId String
  orderId      String
  source       DiscountSource @default(MANUAL)
  type         DiscountType
  value        Float
  amount       Int
  reason       String?
  couponCode   String?
  appliedById  String?
  createdAt    DateTime       @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model OrderTax {
  id            String @id @default(cuid())
  restaurantId  String
  orderId       String
  name          String
  rate          Float
  taxableAmount Int
  amount        Int

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Order timeline (status changes, payments, notes).
model OrderEvent {
  id           String   @id @default(cuid())
  restaurantId String
  orderId      String
  type         String
  message      String
  actorName    String?
  createdAt    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ═══════════════════════════════ Expenses ═══════════════════════════════════

model Expense {
  id             String          @id @default(cuid())
  restaurantId   String
  title          String
  category       ExpenseCategory
  amount         Int
  date           DateTime
  paymentMethod  PaymentMethod   @default(CASH)
  vendor         String?
  notes          String?
  attachmentUrl  String?
  attachmentName String?
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
}

// ═══════════════════════════════ Staff ══════════════════════════════════════

/// HR record. Staff may optionally have a login (RestaurantUser).
model StaffMember {
  id               String      @id @default(cuid())
  restaurantId     String
  restaurantUserId String?     @unique
  name             String
  email            String?
  phone            String
  roleTitle        String
  employeeCode     String
  status           StaffStatus @default(ACTIVE)
  joiningDate      DateTime
  salary           Int         @default(0)
  address          String?
  emergencyContact String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantUser RestaurantUser? @relation(fields: [restaurantUserId], references: [id], onDelete: SetNull)
  attendance     Attendance[]
  shifts         Shift[]

  @@unique([restaurantId, employeeCode])
  @@index([restaurantId])
}

model Attendance {
  id           String           @id @default(cuid())
  restaurantId String
  staffId      String
  date         DateTime         @db.Date
  clockIn      DateTime?
  clockOut     DateTime?
  status       AttendanceStatus @default(PRESENT)
  notes        String?

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staff      StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, date])
  @@index([restaurantId, date])
}

model Shift {
  id           String   @id @default(cuid())
  restaurantId String
  staffId      String
  date         DateTime @db.Date
  startTime    String
  endTime      String
  station      String?
  notes        String?

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  staff      StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([restaurantId, date])
}

// ═══════════════════════════ Inventory & recipes ════════════════════════════

model Supplier {
  id            String   @id @default(cuid())
  restaurantId  String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  gstNumber     String?
  paymentTerms  String?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredients Ingredient[]
  purchases   Purchase[]

  @@unique([restaurantId, name])
}

model Ingredient {
  id              String    @id @default(cuid())
  restaurantId    String
  supplierId      String?
  name            String
  sku             String
  category        String
  unit            StockUnit
  currentStock    Float     @default(0)
  minStock        Float     @default(0)
  maxStock        Float?
  /// Cost per one `unit`, minor currency units.
  costPerUnit     Int       @default(0)
  expiryDate      DateTime?
  storageLocation String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  restaurant    Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier      Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  recipeLines   RecipeIngredient[]
  purchaseItems PurchaseItem[]
  transactions  StockTransaction[]
  wastes        Waste[]

  @@unique([restaurantId, sku])
  @@index([restaurantId, name])
}

model Recipe {
  id              String   @id @default(cuid())
  restaurantId    String
  productId       String   @unique
  yieldQuantity   Int      @default(1)
  wastePercent    Float    @default(0)
  targetFoodCost  Float    @default(30)
  instructions    String?
  prepTimeMinutes Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  restaurant  Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([restaurantId])
}

model RecipeIngredient {
  id           String    @id @default(cuid())
  restaurantId String
  recipeId     String
  ingredientId String
  quantity     Float
  unit         StockUnit
  wastePercent Float     @default(0)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
}

model Purchase {
  id            String         @id @default(cuid())
  restaurantId  String
  supplierId    String?
  reference     String
  invoiceNumber String?
  status        PurchaseStatus @default(DRAFT)
  orderedAt     DateTime?
  receivedAt    DateTime?
  subtotal      Int            @default(0)
  taxAmount     Int            @default(0)
  total         Int            @default(0)
  notes         String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  restaurant Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier   Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items      PurchaseItem[]
  stockTxns  StockTransaction[]

  @@unique([restaurantId, reference])
  @@index([restaurantId, createdAt])
}

model PurchaseItem {
  id           String    @id @default(cuid())
  restaurantId String
  purchaseId   String
  ingredientId String
  quantity     Float
  unit         StockUnit
  unitCost     Int
  total        Int

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  purchase   Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
}

/// Immutable stock ledger. `quantity` is signed and in the ingredient's unit.
model StockTransaction {
  id           String       @id @default(cuid())
  restaurantId String
  ingredientId String
  type         StockTxnType
  quantity     Float
  balanceAfter Float
  unitCost     Int?
  reference    String?
  counterparty String?
  reason       String?
  orderId      String?
  purchaseId   String?
  createdById  String?
  actorName    String?
  createdAt    DateTime     @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  order      Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchase   Purchase?  @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([ingredientId, createdAt])
}

model Waste {
  id           String    @id @default(cuid())
  restaurantId String
  ingredientId String
  quantity     Float
  unit         StockUnit
  reason       String
  cost         Int
  notes        String?
  recordedBy   String?
  createdAt    DateTime  @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

// ═══════════════════════════════ Loyalty ════════════════════════════════════

model LoyaltyProgram {
  restaurantId     String   @id
  isEnabled        Boolean  @default(true)
  /// Points earned for every ₹100 (or 100 major units) spent.
  pointsPerHundred Int      @default(10)
  /// Value of one point in minor units (e.g. 25 = ₹0.25).
  pointValue       Int      @default(25)
  minRedeemPoints  Int      @default(100)
  /// Max share of a bill payable with points, in percent.
  maxRedeemPercent Int      @default(20)
  expiryDays       Int?     @default(365)
  signupBonus      Int      @default(50)
  birthdayBonus    Int      @default(100)
  updatedAt        DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

model LoyaltyAccount {
  id               String   @id @default(cuid())
  restaurantId     String
  customerId       String   @unique
  balance          Int      @default(0)
  lifetimeEarned   Int      @default(0)
  lifetimeRedeemed Int      @default(0)
  lifetimeExpired  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant   Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@index([restaurantId])
}

model LoyaltyTransaction {
  id                String         @id @default(cuid())
  restaurantId      String
  accountId         String
  customerId        String
  orderId           String?
  type              LoyaltyTxnType
  points            Int
  balanceAfter      Int
  description       String
  /// For EARN/BONUS rows: when the points lapse.
  expiresAt         DateTime?
  /// Set once an EARN row has been processed by the expiry job.
  expiryProcessedAt DateTime?
  actorName         String?
  createdAt         DateTime       @default(now())

  restaurant Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  account    LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order      Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([accountId, createdAt])
}

// ═══════════════════════════════ Integrations ═══════════════════════════════

model Integration {
  id               String              @id @default(cuid())
  restaurantId     String
  provider         IntegrationProvider
  status           IntegrationStatus   @default(DISCONNECTED)
  storeId          String?
  autoAcceptOrders Boolean             @default(false)
  autoSyncMenu     Boolean             @default(false)
  syncInventory    Boolean             @default(false)
  syncPricing      Boolean             @default(false)
  lastSyncAt       DateTime?
  lastSyncStatus   String?
  lastError        String?
  connectedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  restaurant     Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  credential     IntegrationCredential?
  externalOrders ExternalOrder[]

  @@unique([restaurantId, provider])
}

/// Secrets are AES-256-GCM encrypted at rest and never sent to the browser.
model IntegrationCredential {
  id               String   @id @default(cuid())
  restaurantId     String
  integrationId    String   @unique
  encryptedPayload String
  keyHint          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  restaurant  Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
}

/// Raw payloads received from aggregators before/after import into Order.
model ExternalOrder {
  id            String              @id @default(cuid())
  restaurantId  String
  integrationId String?
  provider      IntegrationProvider
  externalId    String
  status        ExternalOrderStatus @default(RECEIVED)
  payload       Json
  orderId       String?             @unique
  error         String?
  receivedAt    DateTime            @default(now())
  processedAt   DateTime?

  restaurant  Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, provider, externalId])
}

// ═══════════════════════════════ Audit ══════════════════════════════════════

model AuditLog {
  id           String     @id @default(cuid())
  scope        AuditScope @default(RESTAURANT)
  restaurantId String?
  userId       String?
  actorName    String?
  actorRole    String?
  action       String
  entity       String
  entityId     String?
  summary      String
  ipAddress    String?
  userAgent    String?
  metadata     Json?
  createdAt    DateTime   @default(now())

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([restaurantId, createdAt])
  @@index([userId, createdAt])
  @@index([scope, createdAt])
}

// ═══════════════════════════════ Sales ══════════════════════════════════════

/// A product demo booked from the public website. Platform-level (not a
/// tenant model); managed from the Super Admin console.
model DemoRequest {
  id              String     @id @default(cuid())
  name            String
  email           String
  phone           String
  restaurantName  String
  city            String?
  outlets         Int        @default(1)
  restaurantType  String?
  currentSystem   String?
  message         String?
  /// Start of the slot (UTC instant). Slots are offered in Asia/Kolkata.
  scheduledAt     DateTime
  durationMinutes Int        @default(30)
  status          DemoStatus @default(NEW)
  meetingLink     String?
  adminNotes      String?
  assignedToId    String?
  /// Set when the lead becomes a customer.
  restaurantId    String?
  source          String     @default("website")
  ipAddress       String?
  userAgent       String?
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  assignedTo User?       @relation("DemoAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@index([scheduledAt])
  @@index([email])
}
